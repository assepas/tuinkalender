{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "region.schema.json",
  "title": "Region",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "anchors"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string" },
    "hardinessZone": { "type": "string" },
    "notes": { "type": "string" },
    "anchors": {
      "type": "object",
      "required": ["lastFrost", "firstFrost", "soilWarm"],
      "additionalProperties": false,
      "properties": {
        "lastFrost": { "type": "string", "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
        "firstFrost": { "type": "string", "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
        "soilWarm": { "type": "string", "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" }
      }
    }
  }
}
