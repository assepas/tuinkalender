{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "garden.schema.json",
  "title": "Garden",
  "type": "object",
  "required": ["schemaVersion", "region", "plantings"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "region": { "type": "string" },
    "locations": {
      "type": "array",
      "items": { "$ref": "#/definitions/location" }
    },
    "plantings": {
      "type": "array",
      "items": { "$ref": "#/definitions/planting" }
    }
  },
  "definitions": {
    "location": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["kas", "buiten", "pot"],
          "description": "Vast 'soort plek'-label, los van de vrije naam — houdt taak-condities (conditions.position in soortdata) betrouwbaar werkend."
        },
        "soil": { "type": "string" }
      }
    },
    "planting": {
      "type": "object",
      "required": ["uid", "speciesId"],
      "additionalProperties": false,
      "properties": {
        "uid": { "type": "string" },
        "speciesId": { "type": "string" },
        "label": { "type": "string" },
        "locationId": { "type": ["string", "null"] },
        "plantedOn": { "type": "string" },
        "notes": { "type": "string" },
        "mutedTasks": { "type": "array", "items": { "type": "string" } },
        "extraTasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "window"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "note": { "type": "string" },
              "window": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
