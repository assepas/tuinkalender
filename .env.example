# Kopieer naar .env.local (staat in .gitignore) en vul in vanuit het
# Supabase-dashboard: Project Settings → API Keys (de nieuwe publishable/
# secret keys, niet de "legacy" anon/service_role-tab).

# --- Voor de app (komen in de gebouwde site; mogen publiek zijn) ---
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Alleen voor de beheerscripts (npm run db:seed / db:export) ---
# De secret key omzeilt alle beveiliging (RLS): nooit committen, nooit in
# een VITE_-variabele zetten. Supabase weigert hem ook vanuit een browser.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
