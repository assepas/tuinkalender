{
  "name": "tuintaak",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-species.mjs",
    "validate": "node scripts/validate.mjs",
    "predev": "npm run build:data",
    "dev": "vite",
    "dev:local": "npm run build:data && vite --mode offline",
    "prebuild": "npm run validate && npm run build:data",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "npm run validate && node scripts/seed-supabase.mjs",
    "db:export": "node scripts/export-from-supabase.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "ajv": "^8.17.1",
    "svelte": "^5.1.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1"
  }
}
